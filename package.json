{
  "name": "aboutme",
  "version": "0.0.0",
  "description": "Personal portfolio website",
  "homepage": "https://sushantk.dev",
  "author": {
    "name": "Sushant Kumar",
    "email": "sushant.kum96@gmail.com"
  },
  "license": "ISC",
  "private": true,
  "packageManager": "pnpm@11.16.0",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.16.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">= 22.22",
    "pnpm": ">= 11.16.0",
    "npm": "please-use-pnpm",
    "yarn": "please-use-pnpm"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite-react-ssg build",
    "preview": "vite preview",
    "predeploy:prod": "pnpm run build",
    "deploy:prod": "firebase deploy --only hosting:prod",
    "predeploy:testbed": "pnpm run build",
    "deploy:testbed": "firebase deploy --only hosting:testbed",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "lint:fix": "pnpm run lint --fix",
    "lint:error": "pnpm run lint --quiet",
    "format:fix": "prettier --write .",
    "format:check": "prettier -c .",
    "stylelint": "stylelint '**/*.{css,scss,sass}'",
    "stylelint:error": "pnpm run stylelint --quiet",
    "stylelint:fix": "pnpm run stylelint --fix",
    "secretlint": "secretlint \"**/*\"",
    "spellcheck": "cspell --no-progress --config cspell.json .",
    "knip": "knip",
    "tool::commit": "cz",
    "tool::release": "commit-and-tag-version",
    "tool::check-engines": "ls-engines --production --dev",
    "tool::catalog-packages": "pnpx codemod pnpm/catalog",
    "prepare": "husky"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@gsap/react": "^2.1.2",
    "gsap": "^3.15.0",
    "lucide-react": "^1.25.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^9.39.5",
    "@rolldown/plugin-babel": "^0.2.3",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/babel__core": "^7.20.5",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "commit-and-tag-version": "^13.1.0",
    "commitizen": "^4.3.2",
    "cspell": "^10.0.1",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^63.2.0",
    "eslint-plugin-no-secrets": "^2.3.3",
    "eslint-plugin-prefer-arrow": "^1.2.3",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "eslint-plugin-unused-imports": "^4.4.1",
    "firebase-tools": "^15.24.0",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "jest-axe": "^10.0.0",
    "jsdom": "^29.1.1",
    "knip": "^6.29.0",
    "lint-staged": "^17.1.1",
    "ls-engines": "^0.10.1",
    "prettier": "^3.9.6",
    "sass": "^1.101.3",
    "secretlint": "^13.0.4",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.1.1",
    "vite-react-ssg": "^0.9.2",
    "vitest": "^4.1.10"
  }
}
